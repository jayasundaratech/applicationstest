PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Microsoft Entra ID OIDC
ENTRA_TENANT_ID=your-tenant-id
ENTRA_CLIENT_ID=your-app-registration-client-id
ENTRA_CLIENT_SECRET=your-app-registration-client-secret

# Use a long random value in production
SESSION_SECRET=replace-with-a-long-random-session-secret

# Use this same value as the Secret Token in Entra Enterprise App > Provisioning
SCIM_BEARER_TOKEN=replace-with-a-long-random-scim-token
